# Database
MONGODB_URI=mongodb://localhost:27017/practice1

# JWT Secret
JWT_SECRET=your_super_secret_key_here_change_this_in_production

# Admin ID (lấy từ database sau khi tạo user admin)
ADMIN_ID=your_admin_user_id_here

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Configuration (dùng để gửi email reset password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password_here

# Frontend URL (dùng để tạo link reset password và CORS)
FRONTEND_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173

# Google OAuth Client ID
GOOGLE_CLIENT_ID=your_google_client_id_here

# Note về Email:
# - Nếu dùng Gmail, bạn cần tạo "App Password" thay vì dùng password thường
# - Cách tạo App Password: https://support.google.com/accounts/answer/185833
# - Bước 1: Vào Google Account > Security
# - Bước 2: Bật 2-Step Verification
# - Bước 3: Tạo App Password và copy password đó vào EMAIL_PASS
